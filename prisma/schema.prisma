generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale { CS EN MT }
enum ProductStatus { DRAFT ACTIVE ARCHIVED }
enum MediaKind { IMAGE VIDEO DOCUMENT }
enum PriceType { RETAIL SALE COST }
enum AuditAction { CREATE UPDATE ARCHIVE IMPORT }

model Product {
  id              String              @id @default(cuid())
  sourceId        String?             @unique
  slug            String              @unique
  status          ProductStatus       @default(DRAFT)
  sku             String?             @unique
  manufacturer    String?
  taxRate         Decimal?            @db.Decimal(5, 2)
  sourceUrl       String?
  sourceUpdatedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  translations    ProductTranslation[]
  variants        ProductVariant[]
  categories      ProductCategory[]
  media           ProductMedia[]
  prices          ProductPrice[]
  inventory       Inventory?
  auditEvents     AuditEvent[]
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  locale      Locale
  name        String
  shortDescription String?
  description String   @db.Text
  seoTitle    String?
  seoDescription String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, locale])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique
  name        String?
  optionData  Json
  active      Boolean  @default(true)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices      ProductPrice[]
  @@index([productId, active])
}

model Category {
  id           String              @id @default(cuid())
  slug         String              @unique
  sortOrder    Int                 @default(0)
  translations CategoryTranslation[]
  products     ProductCategory[]
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     Locale
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([categoryId, locale])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  kind      MediaKind @default(IMAGE)
  url       String
  alt       String?
  sortOrder Int       @default(0)
  licensed  Boolean   @default(false)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
}

model ProductPrice {
  id        String      @id @default(cuid())
  productId String?
  variantId String?
  priceType PriceType   @default(RETAIL)
  currency  String      @default("EUR")
  amountMinor Int
  validFrom DateTime    @default(now())
  validTo   DateTime?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@index([productId, currency, priceType, validFrom])
  @@index([variantId, currency, priceType, validFrom])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  source    String?
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SourceImport {
  id          String   @id @default(cuid())
  source      String
  retrievedAt DateTime @default(now())
  itemCount   Int
  checksum    String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
}

model AuditEvent {
  id        String      @id @default(cuid())
  productId String?
  actorId   String
  action    AuditAction
  payload   Json
  createdAt DateTime    @default(now())
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([productId, createdAt])
}
